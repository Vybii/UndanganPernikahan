# Salin file ini menjadi .env lalu isi. JANGAN di-commit / dibagikan (sudah ada di .gitignore).
# Di hosting (Railway, Render, VPS, dll) isi sebagai Environment Variables.

# --- Server ---
PORT=3000
NODE_ENV=production
# Isi 1 kalau di depan server ada Nginx/Caddy/Cloudflare/load balancer hosting (HTTPS).
TRUST_PROXY=1

# --- Oracle Database ---
ORACLE_USER=wedding
ORACLE_PASSWORD=isi-password-user-oracle
# Oracle biasa / XE / on-premise:  host:port/service_name   contoh: db.contoh.com:1521/XEPDB1
# Oracle Autonomous (Cloud): isi nama alias dari tnsnames.ora di wallet, contoh: wedding_high
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
# Hanya untuk Autonomous Database: folder hasil ekstrak Wallet_xxx.zip (berisi tnsnames.ora, ewallet.pem)
# ORACLE_WALLET_DIR=/app/wallet
# ORACLE_WALLET_PASSWORD=password-yang-dibuat-saat-download-wallet
ORACLE_POOL_MAX=5
# Buat tabel otomatis saat server pertama jalan. Isi false kalau tabel dibuat manual (server/schema.sql).
DB_AUTO_INIT=true

# --- Login admin (WAJIB) ---
# Jalankan "npm run setup-admin", lalu tempel 3 baris hasilnya di sini.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Lama login admin (jam)
SESSION_HOURS=24
